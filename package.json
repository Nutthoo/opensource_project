{
  "name": "site-monitor-desktop",
  "productName": "SiteMonitor",
  "version": "1.0.0",
  "description": "웹사이트 상태 모니터링 및 자동 로그인 데스크톱 프로그램",
  "main": "main.js",
  "scripts": {
    "build:exe": "electron-builder --win --config.npmRebuild=false"
  },
  "build": {
    "appId": "com.sitemonitor.desktop",
    "productName": "SiteMonitor",
    "npmRebuild": false,
    "asar": true,
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "node.exe",
        "to": "node.exe"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*", "!sites.db*"]
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": ["**/*", "!**/*.pdb"]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}